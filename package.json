{
  "name": "vs-code-utils",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "bun run test:unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "build": "bun scripts/build.ts",
    "test:unit": "bun test extensions/*/test/unit test/unit",
    "test:integration": "bun run build && node dist/test/integration/run.cjs",
    "package": "bun run typecheck && bun run build && bun run package:smart-paste && bun run package:terminal-tool",
    "package:smart-paste": "cd extensions/codex-smart-paste && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../codex-smart-paste-0.3.0.vsix",
    "package:terminal-tool": "cd extensions/codex-terminal-tool && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../codex-terminal-tool-0.5.0.vsix"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
